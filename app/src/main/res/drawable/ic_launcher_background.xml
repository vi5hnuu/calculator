<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background layer.

  The full 108x108 canvas is filled: the launcher masks this to whatever shape the device
  uses (circle, squircle, rounded square), so the layer must bleed to the edges. Anything
  less and the mask cuts into empty space instead of colour.

  The gradient is the design's accent ramp, the same one behind the ∑ in the app's top bar
  (`linear-gradient(145deg, #2fe08a, #17b268)`).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="14"
                android:startY="0"
                android:endX="94"
                android:endY="108"
                android:startColor="#2FE08A"
                android:endColor="#17B268" />
        </aapt:attr>
    </path>
</vector>
