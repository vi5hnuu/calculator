<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer (Android 13+). The system ignores this colour and tints the shape from
  the user's wallpaper palette, so only the alpha matters — hence the glyph alone, with no
  background. Without this layer the launcher falls back to showing the full-colour icon
  amongst themed ones, which looks out of place.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M72,38 L37,38 L55,54 L37,70 L72,70"
        android:strokeColor="#000000"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
