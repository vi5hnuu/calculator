<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash window background matches the design's dark canvas (#0A110C) so there is no
         flash between the system splash and the Compose content. -->
    <style name="Theme.MathPro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MathPro</item>
    </style>

    <style name="Theme.MathPro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
